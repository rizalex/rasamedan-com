# Database MySQL
DB_HOST=localhost
DB_USER=root
DB_PASS=''
DB_NAME=toko_medan

# WhatsApp (nomor dummy untuk development)
# Nomor UTAMA: khusus pemesanan (checkout & pesan produk).
NEXT_PUBLIC_WA_NUMBER=6281200000000
# Nomor ALTERNATIF: layanan pelanggan / pertanyaan umum (opsional, kosongkan bila tak dipakai).
NEXT_PUBLIC_WA_NUMBER_ALT=6281300000000

# Admin auth
ADMIN_SESSION_SECRET=d5c25f75ec9516bc417cf0baad2d972eff61d05ed444f390372674309b4bbea7

# Google reCAPTCHA (Skill 15)
RECAPTCHA_SITE_KEY=your_site_key
RECAPTCHA_SECRET_KEY=your_secret_key

# Lokasi Toko & Info Kontak (Skill 18)
NEXT_PUBLIC_STORE_NAME="Rasa Medan"
NEXT_PUBLIC_STORE_ADDRESS="Jl. Sisingamangaraja No.123, Medan, Sumatera Utara, Indonesia"
NEXT_PUBLIC_MAPS_EMBED_URL=https://www.google.com/maps/embed?pb=...
NEXT_PUBLIC_MAPS_LINK_URL=https://maps.google.com/?q=...
NEXT_PUBLIC_STORE_HOURS_WEEKDAY="Senin-Sabtu 09.00-18.00 WIB"
NEXT_PUBLIC_STORE_HOURS_WEEKEND="Minggu: Tutup / by request"
NEXT_PUBLIC_IG_URL=https://instagram.com/rasamedan
NEXT_PUBLIC_TIKTOK_URL=https://tiktok.com/@rasamedan
NEXT_PUBLIC_FB_URL=https://facebook.com/rasamedan

# App
# URL publik situs (WAJIB diisi domain asli saat deploy) — dipakai untuk canonical,
# Open Graph, sitemap.xml, dan robots.txt. Tanpa trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SEO / Google Search Console (Skill 19)
# Token verifikasi kepemilikan Search Console (opsional). Isi dengan nilai content
# dari meta tag "google-site-verification" yang diberikan Google saat mendaftarkan situs.
GOOGLE_SITE_VERIFICATION=
