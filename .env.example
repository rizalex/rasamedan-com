# Salin menjadi `.env` (TIDAK di-commit). Dipakai `next dev` dan saat BUILD
# (`npm run deploy` / `npm run preview`). Konfigurasi production TIDAK hidup di
# file ini — lihat DEPLOYMENT.md §0:
#   - NEXT_PUBLIC_* di bawah di-inline ke JavaScript SAAT BUILD → nilai di sini
#     (atau Build variables Workers Builds) = nilai production. Ubah = deploy ulang.
#   - Rahasia runtime production: `npx wrangler secret put <NAMA>`.
#   - Non-rahasia runtime (TURNSTILE_SITE_KEY dll.): `vars` di wrangler.jsonc.
#   - Database & foto: binding D1 `DB` dan R2 `UPLOADS` di wrangler.jsonc (lokal:
#     `npm run db:migrate`, tanpa akun Cloudflare).
# Hanya NEXT_PUBLIC_*, GOOGLE_SITE_VERIFICATION, dan NODE_ENV yang ikut ke bundle
# Worker (scripts/strip-bundle-secrets.mjs) — rahasia di file ini tidak ter-upload.

# --- Situs (WAJIB diisi URL https asli saat deploy; `npm run deploy` menolak localhost/http)
# Dipakai canonical, Open Graph, sitemap, robots, dan cek hostname Turnstile. Tanpa
# trailing slash. Staging: https://rasa-medan.<subdomain>.workers.dev
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- WhatsApp (dummy untuk development — ganti nomor asli pemilik sebelum go-live)
# Nomor UTAMA: khusus pemesanan (checkout & pesan produk). Format 62…, tanpa "+".
NEXT_PUBLIC_WA_NUMBER=6281200000000
# Nomor ALTERNATIF: layanan pelanggan / pertanyaan umum (opsional, kosongkan bila tak dipakai).
NEXT_PUBLIC_WA_NUMBER_ALT=6281300000000

# --- Lokasi Toko & Info Kontak (Skill 18)
NEXT_PUBLIC_STORE_NAME="Rasa Medan"
NEXT_PUBLIC_STORE_ADDRESS="Jl. Sisingamangaraja No.123, Medan, Sumatera Utara, Indonesia"
NEXT_PUBLIC_MAPS_EMBED_URL=https://www.google.com/maps/embed?pb=...
NEXT_PUBLIC_MAPS_LINK_URL=https://maps.google.com/?q=...
NEXT_PUBLIC_STORE_HOURS_WEEKDAY="Senin-Sabtu 09.00-18.00 WIB"
NEXT_PUBLIC_STORE_HOURS_WEEKEND="Minggu: Tutup / by request"
NEXT_PUBLIC_IG_URL=https://instagram.com/rasamedan
NEXT_PUBLIC_TIKTOK_URL=https://tiktok.com/@rasamedan
NEXT_PUBLIC_FB_URL=https://facebook.com/rasamedan

# --- SEO / Google Search Console (Skill 19, opsional)
# Nilai content dari meta tag "google-site-verification".
GOOGLE_SITE_VERIFICATION=

# --- Hanya untuk `next dev` (production: `npx wrangler secret put`, preview: `.dev.vars`)
# String acak milik Anda sendiri, minimal 32 karakter:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Nilai yang pernah ada di riwayat git sudah bocor dan DITOLAK aplikasi.
# Kosong di dev = secret acak sementara (sesi hilang saat restart).
ADMIN_SESSION_SECRET=

# Cloudflare Turnstile untuk dev: kosong = captcha dilewati, atau test key resmi:
#   site 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA
# Production: site key di `vars` wrangler.jsonc, secret via wrangler secret put.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Estimasi ongkir api.co.id (Skill 31) untuk `next dev`. Kosong = fitur mati.
# Asal & batas harian ada di wrangler.jsonc vars (SHIPPING_*); boleh ditimpa di sini.
# Pakai Test Key (tarif mock, gratis) untuk dev. Production: wrangler secret put.
API_CO_ID_KEY=
SHIPPING_ORIGIN_DISTRICT_CODE=120733

# --- Hanya untuk `npm run db:export` (migrasi data cPanel, Skill 25)
# Lewat SSH tunnel: ssh -L 3307:localhost:3306 <user>@<host-cpanel>
# Pakai user MySQL read-only; kosongkan lagi setelah cutover.
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=
DB_PASS=
DB_NAME=
