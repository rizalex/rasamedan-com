{
  "name": "rasa-medan",
  "version": "0.1.0",
  "private": true,
  "description": "Website katalog oleh-oleh khas Medan (MVP) - Rasa Medan",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "db:test": "node --env-file=.env scripts/test-db.mjs",
    "db:schema": "node --env-file=.env scripts/apply-schema.mjs",
    "db:migrate": "node --env-file=.env scripts/migrate-add-weight.mjs",
    "db:repair": "node --env-file=.env scripts/repair-order-items.mjs",
    "seed": "node --env-file=.env scripts/seed.mjs",
    "seed:categories": "node --env-file=.env scripts/seed-categories.mjs",
    "seed:admin": "node --env-file=.env scripts/seed-admin.mjs",
    "preview": "npm run cf:build && opennextjs-cloudflare preview",
    "deploy": "node scripts/check-deploy-env.mjs && npm run cf:build && opennextjs-cloudflare deploy",
    "cf:dryrun": "npm run cf:build && wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "cf:build": "opennextjs-cloudflare build && node scripts/strip-bundle-secrets.mjs",
    "db:migrate:session": "node --env-file=.env scripts/migrate-session-version.mjs"
  },
  "dependencies": {
    "mysql2": "^3.11.5",
    "next": "^15.5.27",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@opennextjs/cloudflare": "^1.20.10",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.27",
    "typescript": "^5.7.3",
    "wrangler": "^4.150.0"
  }
}
