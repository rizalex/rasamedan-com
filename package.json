{
  "name": "rasa-medan",
  "version": "0.1.0",
  "private": true,
  "description": "Website katalog oleh-oleh khas Medan (MVP) - Rasa Medan",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "db:migrate": "wrangler d1 migrations apply rasamedan --local",
    "db:migrate:remote": "wrangler d1 migrations apply rasamedan --remote",
    "seed": "node scripts/seed.mjs",
    "seed:admin": "node scripts/seed-admin.mjs",
    "preview": "npm run cf:build && opennextjs-cloudflare preview",
    "deploy": "node scripts/check-deploy-env.mjs && npm run cf:build && opennextjs-cloudflare deploy",
    "cf:dryrun": "npm run cf:build && wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "cf:build": "opennextjs-cloudflare build && node scripts/strip-bundle-secrets.mjs",
    "cf:typegen": "wrangler types cloudflare-env.d.ts --env-interface CloudflareEnv --include-runtime=false --strict-vars=false --env-file .dev.vars.example"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.10",
    "next": "^15.5.27",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.27",
    "typescript": "^5.7.3",
    "wrangler": "^4.150.0"
  }
}
